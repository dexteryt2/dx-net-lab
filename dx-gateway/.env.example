# DX-Gateway v0.1 configuration
# Copy this file to .env (or set these as real environment variables /
# systemd Environment= lines / Docker -e flags) and fill in the values.
# Nothing here is read from a config file — env vars only.

# --------------------------------------------------------------------------
# LISTEN_ADDR
# Where DX-Gateway itself listens. This is the address your Cloudflare
# Tunnel ingress rule must point at, e.g.:
#   ingress:
#     - hostname: vpn.example.com
#       service: http://localhost:10000
LISTEN_ADDR=0.0.0.0:10000

# --------------------------------------------------------------------------
# XUI_URL (required)
# Base URL of the x-ui panel, INCLUDING its webBasePath, no trailing slash.
# Find webBasePath in x-ui's install output or Settings > Panel Settings.
# Example install output line:
#   Access URL: http://52.173.165.162:37801/MIUS6gT4n83bTmWxI0
# -> XUI_URL=http://127.0.0.1:37801/MIUS6gT4n83bTmWxI0
XUI_URL=http://127.0.0.1:37801/CHANGE_ME_WEBBASEPATH

# --------------------------------------------------------------------------
# XUI_API_TOKEN (required)
# Create this in the x-ui panel: Settings -> API Tokens -> Create.
# DO NOT use your admin username/password here — DX-Gateway only ever
# authenticates with a scoped Bearer token, never a login/session.
XUI_API_TOKEN=

# --------------------------------------------------------------------------
# XUI_DB_PATH
# Path to x-ui's SQLite file, used ONLY as a fallback when XUI_URL is
# unreachable for DISCOVERY_API_FAILURE_THRESHOLD consecutive sync ticks.
# Default matches x-ui's own install.sh default.
XUI_DB_PATH=/etc/x-ui/x-ui.db

# --------------------------------------------------------------------------
# SQLITE3_BIN
# Path/name of the sqlite3 CLI binary used for the fallback above.
# The stock Docker image already has this on PATH; override only if you're
# running the raw binary somewhere sqlite3 isn't at the default PATH entry.
SQLITE3_BIN=sqlite3

# --------------------------------------------------------------------------
# SYNC_INTERVAL_SECONDS
# How often DX-Gateway re-polls x-ui for inbound changes (create/edit/
# enable/disable/delete). Lower = faster hot-reload, more request volume
# against the x-ui API/DB.
SYNC_INTERVAL_SECONDS=5

# --------------------------------------------------------------------------
# DISCOVERY_API_FAILURE_THRESHOLD
# Number of consecutive failed API calls before DX-Gateway switches to the
# read-only SQLite fallback. It automatically switches back the moment the
# API succeeds again (checked every tick, no restart needed).
DISCOVERY_API_FAILURE_THRESHOLD=3

# --------------------------------------------------------------------------
# HTTP_REQUEST_TIMEOUT_SECONDS
# Timeout for each call DX-Gateway makes to the x-ui API.
HTTP_REQUEST_TIMEOUT_SECONDS=10

# --------------------------------------------------------------------------
# LOG_LEVEL
# Currently informational only (all logs are tagged [DISCOVERY]/[ROUTER]/
# [STARTUP]/[SHUTDOWN] and always printed) — reserved for a future
# verbosity filter.
LOG_LEVEL=info
